# Порт сервера (по умолчанию 3001)
PORT=3001

# Провайдер распознавания фото: gemini (по умолчанию) или gigachat.
RECOGNIZE_PROVIDER=gemini

# --- Gemini (Google AI Studio) — основной ---
# Ключ: aistudio.google.com → «Get API key». Из РФ до Google обычно нужен VPN/прокси на сервере.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash      # pro-модели на бесплатном тарифе отдают 429; список доступных: GET /v1beta/models
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com   # переопредели, если идёшь через прокси

# --- GigaChat (Сбер) — резерв (RECOGNIZE_PROVIDER=gigachat) ---
# Ключи: developers.sber.ru → проект «GigaChat API» → «Авторизационные данные».
GIGACHAT_AUTH_KEY=          # Base64 «Authorization key» (client_id:client_secret)
GIGACHAT_SCOPE=GIGACHAT_API_PERS   # физлица (бесплатный лимит) или GIGACHAT_API_B2B (платно)
GIGACHAT_MODEL=GigaChat-2-Max

# Доверие к сертификатам Сбера (НУЦ Минцифры). Указывает Node на PEM с корневыми
# сертификатами. Задаётся как переменная окружения процесса (для службы — в WinSW .xml).
# NODE_EXTRA_CA_CERTS=./certs/russian_trusted_ca.pem
